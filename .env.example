# Copy this file to ".env" and fill in the real values.
# ".env" is git-ignored, so your secrets never end up in the repository.
#
# The NUXT_ prefix makes Nuxt override the matching runtimeConfig key
# (see nuxt.config.ts):
#   NUXT_SUPABASE_URL              -> runtimeConfig.supabaseUrl
#   NUXT_SUPABASE_SERVICE_ROLE_KEY -> runtimeConfig.supabaseServiceRoleKey
#   NUXT_ADMIN_PASSWORD            -> runtimeConfig.adminPassword

# --- Database (required) ---------------------------------------------------
# Supabase project URL (Project Settings -> API -> Project URL).
NUXT_SUPABASE_URL=

# Supabase "service_role" key (Project Settings -> API -> service_role).
# SECRET: full database access, server-only. Never expose it to the browser.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# --- Admin area (required) -------------------------------------------------
# Secret used by nuxt-auth-utils to seal the session cookie.
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Single password to log into the protected /admin area.
NUXT_ADMIN_PASSWORD=

# --- Email notifications (optional) ----------------------------------------
# When NUXT_RESEND_API_KEY is empty, the contact endpoint only saves the lead
# to the database and skips sending email. Fill these to also send email.

# Resend API key (https://resend.com/api-keys).
NUXT_RESEND_API_KEY=

# Address that RECEIVES the form messages (your inbox).
NUXT_CONTACT_RECIPIENT_EMAIL=

# Sender address the email is sent FROM.
# For testing you can use onboarding@resend.dev (provided by Resend).
# In production, use an address on a domain you verified in Resend.
NUXT_CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- Rate limiting (optional) ----------------------------------------------
# Upstash Redis credentials for rate limiting (https://console.upstash.com).
# If unreachable/empty, the endpoint "fails open" and does not block requests.
NUXT_UPSTASH_REDIS_REST_URL=
NUXT_UPSTASH_REDIS_REST_TOKEN=

# Optional: also send a confirmation email to the visitor after a successful
# submission. Off by default. Requires a verified sender domain in Resend.
NUXT_CONTACT_SEND_CONFIRMATION=false

# --- AI features: triage, spam filter (optional) ---------------------------
# When NUXT_ANTHROPIC_API_KEY is empty, AI-based features (lead triage,
# smart spam filter) are skipped and the form behaves as if they didn't exist.
# Get a key at https://console.anthropic.com/settings/keys.
# Only the message text is ever sent — never the name or email.
NUXT_ANTHROPIC_API_KEY=
